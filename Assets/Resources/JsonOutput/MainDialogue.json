    "TexturePath": "Texture2D/Character_Sei_Basic",
    "VoicePath": null
  },
  {
    "Id": "dialogue_mainDialogue_2_3_010",
    "CharacterDataId": "character_sei_1",
    "Description": "\"우리는 감시하고, 또한 수호한다!\"",
    "NextDialogueId": "dialogue_mainDialogue_2_3_011",
    "SelectionNameList": null,
    "SelectionDialogueIdList": null,
    "TexturePath": "Texture2D/Character_Sei_Basic",
    "VoicePath": null
  },
  {
