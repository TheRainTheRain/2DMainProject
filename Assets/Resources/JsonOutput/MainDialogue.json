  },
  {
    "Id": "dialogue_tutorial_1_1_001",
    "CharacterDataId": "character_gillian_01",
    "Description": "아! 어서 와, 질.",
    "NextDialogueId": "dialogue_mainstream_1_1_300",
    "SelectionNameList": null,
    "SelectionDialogueIdList": null,
    "TexturePath": null,
    "VoicePath": null
  },
  {
    "Id": "dialogue_tutorial_1_1_002",
