  },
  {
    "Id": "dialogue_mainDialogue_2_2_004",
    "CharacterDataId": "character_jill_01",
    "Description": "다시한번 세이에게 문블라스트를 만들어주자. 문블라스트!",
    "NextDialogueId": null,
